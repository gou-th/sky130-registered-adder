# --- 1. Load Golden RTL ---
read_verilog adder.v
# Logic must be 'elaborated' to internal gates
prep -top adder
design -stash golden

# --- 2. Load Revised Netlist ---
read_liberty -lib /home/gou/.ciel/ciel/sky130/versions/0fe599b2afb6708d281543108caf8310912f54af/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
read_verilog adder_netlist.v
# Convert Sky130 gates back to generic logic to match RTL
hierarchy -check -top adder
abc -g simple
prep -top adder
design -stash revised

# --- 3. Run LEC ---
design -copy-from golden -as gold adder
design -copy-from revised -as gate adder

equiv_make gold gate equiv
# Initial match of flip-flops by name
equiv_simple
# Sequential proof using induction (The 'Heavy Lifter')
equiv_induct
equiv_status -assert