#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x643b48758430 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x643b487585c0 .scope module, "tb_adder" "tb_adder" 3 3;
 .timescale -9 -12;
v0x643b4876efd0_0 .var "a", 7 0;
v0x643b4876f0b0_0 .var "b", 7 0;
v0x643b4876f150_0 .var "clk", 0 0;
v0x643b4876f1f0_0 .var "rst", 0 0;
v0x643b4876f2c0_0 .net "sum", 7 0, v0x643b487476c0_0;  1 drivers
E_0x643b4871e1b0 .event posedge, v0x643b48745c10_0;
S_0x643b4871dcf0 .scope module, "dut" "adder" 3 7, 4 3 0, S_0x643b487585c0;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 8 "a";
    .port_info 3 /INPUT 8 "b";
    .port_info 4 /OUTPUT 8 "sum";
v0x643b4871fba0_0 .net "a", 7 0, v0x643b4876efd0_0;  1 drivers
v0x643b48745790_0 .net "b", 7 0, v0x643b4876f0b0_0;  1 drivers
v0x643b48745c10_0 .net "clk", 0 0, v0x643b4876f150_0;  1 drivers
v0x643b487472a0_0 .net "rst", 0 0, v0x643b4876f1f0_0;  1 drivers
v0x643b487476c0_0 .var "sum", 7 0;
E_0x643b4871e420/0 .event negedge, v0x643b487472a0_0;
E_0x643b4871e420/1 .event posedge, v0x643b48745c10_0;
E_0x643b4871e420 .event/or E_0x643b4871e420/0, E_0x643b4871e420/1;
    .scope S_0x643b4871dcf0;
T_0 ;
    %wait E_0x643b4871e420;
    %load/vec4 v0x643b487472a0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x643b487476c0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x643b4871fba0_0;
    %load/vec4 v0x643b48745790_0;
    %add;
    %assign/vec4 v0x643b487476c0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x643b487585c0;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x643b4876f150_0;
    %inv;
    %store/vec4 v0x643b4876f150_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x643b487585c0;
T_2 ;
    %vpi_call/w 3 19 "$dumpfile", "waves.vcd" {0 0 0};
    %vpi_call/w 3 20 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x643b487585c0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x643b4876f150_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x643b4876f1f0_0, 0, 1;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x643b4876efd0_0, 0, 8;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x643b4876f0b0_0, 0, 8;
    %pushi/vec4 2, 0, 32;
T_2.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_2.1, 5;
    %jmp/1 T_2.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x643b4871e1b0;
    %jmp T_2.0;
T_2.1 ;
    %pop/vec4 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x643b4876f1f0_0, 0, 1;
    %wait E_0x643b4871e1b0;
    %pushi/vec4 15, 0, 8;
    %store/vec4 v0x643b4876efd0_0, 0, 8;
    %pushi/vec4 25, 0, 8;
    %store/vec4 v0x643b4876f0b0_0, 0, 8;
    %wait E_0x643b4871e1b0;
    %delay 1000, 0;
    %vpi_call/w 3 39 "$display", "Time: %0t | A: %d + B: %d = SUM: %d", $time, v0x643b4876efd0_0, v0x643b4876f0b0_0, v0x643b4876f2c0_0 {0 0 0};
    %wait E_0x643b4871e1b0;
    %pushi/vec4 100, 0, 8;
    %store/vec4 v0x643b4876efd0_0, 0, 8;
    %pushi/vec4 50, 0, 8;
    %store/vec4 v0x643b4876f0b0_0, 0, 8;
    %wait E_0x643b4871e1b0;
    %delay 1000, 0;
    %vpi_call/w 3 48 "$display", "Time: %0t | A: %d + B: %d = SUM: %d", $time, v0x643b4876efd0_0, v0x643b4876f0b0_0, v0x643b4876f2c0_0 {0 0 0};
    %pushi/vec4 2, 0, 32;
T_2.2 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_2.3, 5;
    %jmp/1 T_2.3, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0x643b4871e1b0;
    %jmp T_2.2;
T_2.3 ;
    %pop/vec4 1;
    %vpi_call/w 3 51 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
