#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x6057af2e7ef0 .scope module, "tb_adder" "tb_adder" 2 3;
 .timescale -9 -12;
v0x6057af2fce10_0 .var "a", 7 0;
v0x6057af2fcef0_0 .var "b", 7 0;
v0x6057af2fcfc0_0 .var "clk", 0 0;
v0x6057af2fd0c0_0 .var "rst", 0 0;
v0x6057af2fd190_0 .net "sum", 7 0, v0x6057af2fcc40_0;  1 drivers
E_0x6057af2e6e20 .event negedge, v0x6057af2fcae0_0;
S_0x6057af2e80a0 .scope module, "dut" "adder" 2 12, 3 3 0, S_0x6057af2e7ef0;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 8 "a";
    .port_info 3 /INPUT 8 "b";
    .port_info 4 /OUTPUT 8 "sum";
v0x6057af2d4f40_0 .net "a", 7 0, v0x6057af2fce10_0;  1 drivers
v0x6057af2d5350_0 .net "b", 7 0, v0x6057af2fcef0_0;  1 drivers
v0x6057af2fcae0_0 .net "clk", 0 0, v0x6057af2fcfc0_0;  1 drivers
v0x6057af2fcb80_0 .net "rst", 0 0, v0x6057af2fd0c0_0;  1 drivers
v0x6057af2fcc40_0 .var "sum", 7 0;
E_0x6057af2ae2d0/0 .event negedge, v0x6057af2fcb80_0;
E_0x6057af2ae2d0/1 .event posedge, v0x6057af2fcae0_0;
E_0x6057af2ae2d0 .event/or E_0x6057af2ae2d0/0, E_0x6057af2ae2d0/1;
    .scope S_0x6057af2e80a0;
T_0 ;
    %wait E_0x6057af2ae2d0;
    %load/vec4 v0x6057af2fcb80_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x6057af2fcc40_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x6057af2d4f40_0;
    %load/vec4 v0x6057af2d5350_0;
    %add;
    %assign/vec4 v0x6057af2fcc40_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x6057af2e7ef0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x6057af2fcfc0_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/vec4 v0x6057af2fcfc0_0;
    %inv;
    %store/vec4 v0x6057af2fcfc0_0, 0, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_0x6057af2e7ef0;
T_2 ;
    %vpi_call 2 26 "$dumpfile", "gls_waves.vcd" {0 0 0};
    %vpi_call 2 27 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x6057af2e7ef0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x6057af2fd0c0_0, 0, 1;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x6057af2fce10_0, 0, 8;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x6057af2fcef0_0, 0, 8;
    %delay 20000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x6057af2fd0c0_0, 0, 1;
    %wait E_0x6057af2e6e20;
    %pushi/vec4 10, 0, 8;
    %store/vec4 v0x6057af2fce10_0, 0, 8;
    %pushi/vec4 20, 0, 8;
    %store/vec4 v0x6057af2fcef0_0, 0, 8;
    %wait E_0x6057af2e6e20;
    %pushi/vec4 50, 0, 8;
    %store/vec4 v0x6057af2fce10_0, 0, 8;
    %pushi/vec4 50, 0, 8;
    %store/vec4 v0x6057af2fcef0_0, 0, 8;
    %wait E_0x6057af2e6e20;
    %pushi/vec4 200, 0, 8;
    %store/vec4 v0x6057af2fce10_0, 0, 8;
    %pushi/vec4 55, 0, 8;
    %store/vec4 v0x6057af2fcef0_0, 0, 8;
    %delay 30000, 0;
    %vpi_call 2 45 "$display", "Simulation Complete." {0 0 0};
    %vpi_call 2 46 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb_adder.v";
    "adder.v";
